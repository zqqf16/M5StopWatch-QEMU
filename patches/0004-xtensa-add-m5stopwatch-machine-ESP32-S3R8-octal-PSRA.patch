+/* M5Stack StopWatch (ESP32-S3R8 + CO5300 AMOLED + I2C peripherals) */
+static void m5stopwatch_machine_init(MachineState *machine)
+{
+    m5stopwatch_board = true;
+    esp32s3_machine_init(machine);
+}
+
+static void m5stopwatch_machine_class_init(ObjectClass *oc, void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(oc);
+    mc->desc = "M5Stack StopWatch (ESP32-S3R8, CO5300 466x466 AMOLED)";
+    mc->init = m5stopwatch_machine_init;
+    mc->max_cpus = 2;
+    mc->default_cpus = 2;
+    mc->default_ram_size = 8 * MiB;
+    mc->fixup_ram_size = esp32s3_fixup_ram_size;
+}
+
+static const TypeInfo m5stopwatch_info = {
+    .name = MACHINE_TYPE_NAME("m5stopwatch"),
+    .parent = TYPE_ESP32S3_MACHINE,
+    .instance_size = sizeof(Esp32s3MachineState),
+    .class_init = m5stopwatch_machine_class_init,
+};
+
+static void m5stopwatch_machine_type_init(void)
+{
+    type_register_static(&m5stopwatch_info);
+}
+
+type_init(m5stopwatch_machine_type_init);
