 hw/m5stopwatch/esp32s3_i2c.c   | 294 +++++++++++++++++++++++++++
 hw/m5stopwatch/m5stopwatch.h   |  32 +++
 hw/m5stopwatch/m5sw_i2c_devs.c | 272 +++++++++++++++++++++++++
